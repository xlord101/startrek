generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String            @id @default(uuid())
  name          String
  email         String            @unique
  passwordHash  String
  role          UserRole          @default(FIELD_SUPERVISOR)
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  auditLogs     AuditLog[]
  harvestTasks  HarvestTask[]     @relation("HarvestSupervisor")
  notifications Notification[]
  approvedTasks ProcurementTask[] @relation("ApprovedAdmin")
  assignedTasks ProcurementTask[] @relation("AssignedSupervisor")
  sessions      Session[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Farmer {
  id           String            @id @default(uuid())
  name         String
  mobileNumber String            @unique
  address      String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  harvestTasks HarvestTask[]
  tasks        ProcurementTask[]

  @@map("farmers")
}

model ProcurementTask {
  id                    String            @id @default(uuid())
  farmerId              String
  approxTonnage         Decimal           @db.Decimal(10, 2)
  status                ProcurementStatus @default(PENDING_ASSIGNMENT)
  supervisorId          String?
  assignedAt            DateTime?
  actualTonnage         Decimal?          @db.Decimal(10, 2)
  ratioPercentage       Decimal?          @db.Decimal(5, 2)
  quality               QualityType?
  rejectionReason       String?
  altMobileNumber       String?
  rate                  Decimal?          @db.Decimal(10, 2)
  supervisorRatePerKg   Decimal?          @db.Decimal(10, 2)
  supervisorSubmittedAt DateTime?
  finalRate             Decimal?          @db.Decimal(10, 2)
  approvedById          String?
  approvedAt            DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  harvestTask           HarvestTask?
  approvedBy            User?             @relation("ApprovedAdmin", fields: [approvedById], references: [id])
  farmer                Farmer            @relation(fields: [farmerId], references: [id])
  supervisor            User?             @relation("AssignedSupervisor", fields: [supervisorId], references: [id])
  particulars           TaskParticular[]

  @@map("procurement_tasks")
}

model TaskParticular {
  id        String          @id @default(uuid())
  taskId    String
  boxType   BoxType
  createdAt DateTime        @default(now())
  task      ProcurementTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("task_particulars")
}

model HarvestTask {
  id                     String                   @id @default(uuid())
  procurementTaskId      String                   @unique
  farmerId               String
  tonnage                Decimal                  @db.Decimal(10, 2)
  quality                QualityType
  finalRate              Decimal                  @db.Decimal(10, 2)
  status                 HarvestTaskStatus        @default(READY_FOR_HARVEST)
  isHighPriority         Boolean                  @default(false)
  supervisorId           String?
  brandName              String?
  vehicleSupplierId      String?
  labourTeam             String?
  hasChemicalTreatment   Boolean                  @default(true)
  chemicals              ChemicalOption[]
  hasEthylenePaper       Boolean                  @default(false)
  ethylenePacksCount     Int                      @default(0)
  germinationPaperPcs    Int                      @default(0)
  topBundlesCount        Int                      @default(0)
  bottomBundlesCount     Int                      @default(0)
  fieldDamagedBoxes      Int                      @default(0)
  currentFilledBoxes     Int                      @default(0)
  targetRequiredBoxes    Int                      @default(0)
  gapBoxes               Int                      @default(0)
  shortfallReason        String?
  isForceCompleted       Boolean                  @default(false)
  pingIntervalHours      Int                      @default(2)
  truckNumber            String?
  driverName             String?
  driverPhone            String?
  destinationColdStorage String?
  assignedAt             DateTime?
  startedAt              DateTime?
  completedAt            DateTime?
  dispatchedAt           DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  actualBoxPickups       Json?
  billData               Json?
  harvestedBoxes         Int                      @default(0)
  requiredBoxCounts      Json?
  selectedBoxTypes       BoxType[]
  materialsIssued        Boolean                  @default(false)
  coldStorageReceipt     ColdStorageReceipt?
  farmer                 Farmer                   @relation(fields: [farmerId], references: [id])
  procurementTask        ProcurementTask          @relation(fields: [procurementTaskId], references: [id])
  supervisor             User?                    @relation("HarvestSupervisor", fields: [supervisorId], references: [id])
  vehicleSupplier        VehicleSupplier?         @relation(fields: [vehicleSupplierId], references: [id])
  returnRequests         InventoryReturnRequest[]

  @@map("harvest_tasks")
}

model InventoryStock {
  id             String   @id @default(uuid())
  boxType        BoxType  @unique
  availableStock Int      @default(1000)
  issuedStock    Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@map("inventory_stock")
}

model ConsumableInventoryStock {
  id             String   @id @default(uuid())
  itemType       String   @unique // e.g., "ETHYLENE_POUCH", "ETHYLENE_PAPER", "FUNGICIDE_DIP", "BAGS"
  availableStock Int      @default(0)
  issuedStock    Int      @default(0)
  unit           String   @default("units")
  updatedAt      DateTime @updatedAt

  @@map("consumable_inventory_stock")
}

model InventoryReturnRequest {
  id                  String              @id @default(uuid())
  harvestTaskId       String
  farmerName          String
  boxType             BoxType
  expectedReturnBoxes Int
  actualReturnedBoxes Int?
  wastageBoxes        Int?
  status              ReturnRequestStatus @default(PENDING_VERIFICATION)
  submittedAt         DateTime            @default(now())
  verifiedAt          DateTime?
  harvestTask         HarvestTask         @relation(fields: [harvestTaskId], references: [id])

  @@map("inventory_return_requests")
}

model ColdStorageReceipt {
  id                   String                      @id @default(uuid())
  harvestTaskId        String                      @unique
  farmerName           String
  vehicleNo            String
  driverName           String
  driverPhone          String
  dispatchedTotalBoxes Int
  verifiedBoxCount     Int?
  discrepancyNote      String?
  status               ColdStorageStatus           @default(DISPATCHED)
  receivedAt           DateTime?
  allocatedAt          DateTime?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  allocations          ColdRoomAllocation[]
  harvestTask          HarvestTask                 @relation(fields: [harvestTaskId], references: [id])
  qualityReport        KDColdStorageQualityReport?

  @@map("cold_storage_receipts")
}

model ColdRoomAllocation {
  id          String             @id @default(uuid())
  receiptId   String
  roomNumber  String
  brandName   String
  boxCount    Int
  box4H       Int                @default(0)
  box5H       Int                @default(0)
  box6H       Int                @default(0)
  box7H       Int                @default(0)
  box8H       Int                @default(0)
  allocatedAt DateTime           @default(now())
  receipt     ColdStorageReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@map("cold_room_allocations")
}

model KDColdStorageQualityReport {
  id                   String             @id @default(uuid())
  receiptId            String             @unique
  date                 String
  vehicleNo            String
  lineName             String
  supervisorName       String
  vendorName           String
  outerBoxQuality      String             @default("GOOD")
  packingQuality       String             @default("EXPORT")
  numberOfHands        String
  fingerLengthDiameter String
  boxWeightKg          Decimal            @db.Decimal(5, 2)
  damageOnHand         String             @default("NONE")
  latexSpots           Boolean            @default(false)
  redRust              Boolean            @default(false)
  flowerRemoved        Boolean            @default(true)
  overallQuality       String             @default("A_GRADE_EXPORT")
  box4H                Int                @default(0)
  box5H                Int                @default(0)
  box6H                Int                @default(0)
  box7H                Int                @default(0)
  box8H                Int                @default(0)
  totalBox             Int
  damageBox            Int                @default(0)
  boxBrand             String
  createdAt            DateTime           @default(now())
  receipt              ColdStorageReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@map("kd_cold_storage_quality_reports")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  userRole   UserRole
  action     String
  entityType String
  entityId   String
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model VehicleSupplier {
  id            String        @id @default(uuid())
  supplierName  String
  vehicleNumber String
  driverName    String?
  driverPhone   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  harvestTasks  HarvestTask[]

  @@map("vehicle_suppliers")
}

enum UserRole {
  MAIN_ADMIN
  OFFICE_ADMIN
  FIELD_SUPERVISOR
  PROCUREMENT_SUPERVISOR
  INVENTORY_ADMIN
  COLD_STORAGE_ADMIN
}

enum ProcurementStatus {
  PENDING_ASSIGNMENT
  ASSIGNED
  FIELD_SUBMITTED
  APPROVED_PROCUREMENT
}

enum HarvestTaskStatus {
  READY_FOR_HARVEST
  HARVEST_ASSIGNED
  PICKUP_COMPLETED
  WORK_STARTED
  HARVEST_IN_PROGRESS
  HARVEST_COMPLETED
  DISPATCHED_TO_COLD_STORAGE
}

enum ColdStorageStatus {
  DISPATCHED
  VERIFIED_RECEIVED
  ALLOCATED_TO_ROOMS
}

enum ReturnRequestStatus {
  PENDING_VERIFICATION
  VERIFIED_RESTOCKED
}

enum QualityType {
  EXCELLENT
  GOOD
  AVERAGE
  REJECT
}

enum BoxType {
  BOX_5KG
  BOX_7KG
  BOX_13KG
  BOX_13_5KG
  BOX_16KG
}

enum ChemicalOption {
  ETHYLENE_WASH
  FUNGICIDE_DIP
  ALUM_TREATMENT
  PROTECTIVE_COATING
}
