datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─── Enums ─────────────────────────────────────────────────────────────

enum UserRole {
  MAIN_ADMIN
  OFFICE_ADMIN
  SUPERVISOR
  INVENTORY_ADMIN
  COLD_STORAGE_ADMIN
}

enum ProcurementStatus {
  PENDING_ASSIGNMENT
  ASSIGNED
  FIELD_SUBMITTED
  APPROVED_PROCUREMENT
}

enum HarvestTaskStatus {
  READY_FOR_HARVEST
  HARVEST_ASSIGNED
  PICKUP_COMPLETED
  WORK_STARTED
  HARVEST_IN_PROGRESS
  HARVEST_COMPLETED
  DISPATCHED_TO_COLD_STORAGE
}

enum ColdStorageStatus {
  DISPATCHED
  VERIFIED_RECEIVED
  ALLOCATED_TO_ROOMS
}

enum ReturnRequestStatus {
  PENDING_VERIFICATION
  VERIFIED_RESTOCKED
}

enum QualityType {
  EXCELLENT
  GOOD
  AVERAGE
  REJECT
}

enum BoxType {
  BOX_5KG
  BOX_7KG
  BOX_13KG
  BOX_13_5KG
  BOX_16KG
}

enum ChemicalOption {
  ETHYLENE_WASH
  FUNGICIDE_DIP
  ALUM_TREATMENT
  PROTECTIVE_COATING
}

// ─── User Model (Staff Credentials & Roles) ───────────────────────────

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(SUPERVISOR)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  assignedTasks ProcurementTask[] @relation("AssignedSupervisor")
  approvedTasks ProcurementTask[] @relation("ApprovedAdmin")
  harvestTasks  HarvestTask[]     @relation("HarvestSupervisor")
  auditLogs     AuditLog[]
  notifications Notification[]
  sessions      Session[]

  @@map("users")
}

// ─── Session Model (JWT Cookie Token Management) ──────────────────────

model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@map("sessions")
}

// ─── Farmer Model (Central Registry) ──────────────────────────────────

model Farmer {
  id           String   @id @default(uuid())
  name         String
  mobileNumber String   @unique
  address      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tasks        ProcurementTask[]
  harvestTasks HarvestTask[]

  @@map("farmers")
}

// ─── Procurement Task Model (Module 1 Pipeline) ───────────────────────

model ProcurementTask {
  id            String            @id @default(uuid())
  farmerId      String
  farmer        Farmer            @relation(fields: [farmerId], references: [id])
  approxTonnage Decimal           @db.Decimal(10, 2)
  status        ProcurementStatus @default(PENDING_ASSIGNMENT)

  // Supervisor allocation
  supervisorId String?
  supervisor   User?     @relation("AssignedSupervisor", fields: [supervisorId], references: [id])
  assignedAt   DateTime?

  // Field inspection (Supervisor submission)
  actualTonnage         Decimal?         @db.Decimal(10, 2)
  ratioPercentage       Decimal?         @db.Decimal(5, 2)
  quality               QualityType?
  rejectionReason       String?
  altMobileNumber       String?
  rate                  Decimal?         @db.Decimal(10, 2) // Rate per Kg
  supervisorRatePerKg   Decimal?         @db.Decimal(10, 2) // Proposed Rate per Kg
  supervisorSubmittedAt DateTime?
  particulars           TaskParticular[]

  // Admin final approval
  finalRate    Decimal?  @db.Decimal(10, 2) // Locked Rate per Kg
  approvedById String?
  approvedBy   User?     @relation("ApprovedAdmin", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  harvestTask HarvestTask?

  @@map("procurement_tasks")
}

// ─── Task Particulars (Dynamic Box Types per Farm) ─────────────────────

model TaskParticular {
  id        String          @id @default(uuid())
  taskId    String
  task      ProcurementTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  boxType   BoxType
  createdAt DateTime        @default(now())

  @@map("task_particulars")
}

// ─── Harvest Task Model (Module 2 Pipeline) ───────────────────────────

model HarvestTask {
  id                  String            @id @default(uuid())
  procurementTaskId   String            @unique
  procurementTask     ProcurementTask   @relation(fields: [procurementTaskId], references: [id])
  farmerId            String
  farmer              Farmer            @relation(fields: [farmerId], references: [id])
  tonnage             Decimal           @db.Decimal(10, 2)
  quality             QualityType
  finalRate           Decimal           @db.Decimal(10, 2)
  status              HarvestTaskStatus @default(READY_FOR_HARVEST)
  isHighPriority      Boolean           @default(false)

  supervisorId        String?
  supervisor          User?             @relation("HarvestSupervisor", fields: [supervisorId], references: [id])
  brandName           String?
  vehicleSupplierId   String?
  labourTeam          String?

  // Chemical & Packaging Flags
  hasChemicalTreatment Boolean          @default(true)
  chemicals            ChemicalOption[]
  hasEthylenePaper     Boolean          @default(false)
  ethylenePacksCount   Int              @default(0)
  germinationPaperPcs  Int              @default(0)
  topBundlesCount      Int              @default(0)
  bottomBundlesCount   Int              @default(0)
  fieldDamagedBoxes    Int              @default(0)

  // Box Requirements & Pickup
  selectedBoxTypes     BoxType[]
  requiredBoxCounts    Json?
  actualBoxPickups     Json?
  harvestedBoxes       Int              @default(0)

  // 2-Hour Progress & Shortfall
  currentFilledBoxes   Int              @default(0)
  targetRequiredBoxes  Int              @default(0)
  gapBoxes             Int              @default(0)
  shortfallReason      String?
  isForceCompleted     Boolean          @default(false)
  pingIntervalHours    Int              @default(2)

  // Logistics & Dispatched Bill
  billData             Json?

  // Logistics & Dispatched Bill
  truckNumber          String?
  driverName           String?
  driverPhone          String?
  destinationColdStorage String?

  assignedAt           DateTime?
  startedAt            DateTime?
  completedAt          DateTime?
  dispatchedAt         DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  coldStorageReceipt   ColdStorageReceipt?
  returnRequests       InventoryReturnRequest[]

  @@map("harvest_tasks")
}

// ─── Inventory Stock Model ──────────────────────────────────────────────

model InventoryStock {
  id             String   @id @default(uuid())
  boxType        BoxType  @unique
  availableStock Int      @default(1000)
  issuedStock    Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@map("inventory_stock")
}

// ─── Inventory Return Request Model ────────────────────────────────────

model InventoryReturnRequest {
  id                  String              @id @default(uuid())
  harvestTaskId       String
  harvestTask         HarvestTask         @relation(fields: [harvestTaskId], references: [id])
  farmerName          String
  boxType             BoxType
  expectedReturnBoxes Int
  actualReturnedBoxes Int?
  wastageBoxes        Int?
  status              ReturnRequestStatus @default(PENDING_VERIFICATION)
  submittedAt         DateTime            @default(now())
  verifiedAt          DateTime?

  @@map("inventory_return_requests")
}

// ─── Cold Storage Receipt & Quality Report Model ───────────────────────

model ColdStorageReceipt {
  id                   String                       @id @default(uuid())
  harvestTaskId        String                       @unique
  harvestTask          HarvestTask                  @relation(fields: [harvestTaskId], references: [id])
  farmerName           String
  vehicleNo            String
  driverName           String
  driverPhone          String
  dispatchedTotalBoxes Int
  verifiedBoxCount     Int?
  discrepancyNote      String?
  status               ColdStorageStatus            @default(DISPATCHED)
  receivedAt           DateTime?
  allocatedAt          DateTime?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  allocations          ColdRoomAllocation[]
  qualityReport        KDColdStorageQualityReport?

  @@map("cold_storage_receipts")
}

model ColdRoomAllocation {
  id         String             @id @default(uuid())
  receiptId  String
  receipt    ColdStorageReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  roomNumber String
  brandName  String
  boxCount   Int
  box4H      Int                @default(0)
  box5H      Int                @default(0)
  box6H      Int                @default(0)
  box7H      Int                @default(0)
  box8H      Int                @default(0)
  allocatedAt DateTime          @default(now())

  @@map("cold_room_allocations")
}

model KDColdStorageQualityReport {
  id                   String             @id @default(uuid())
  receiptId            String             @unique
  receipt              ColdStorageReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  date                 String
  vehicleNo            String
  lineName             String
  supervisorName       String
  vendorName           String
  outerBoxQuality      String             @default("GOOD") // GOOD, FAIR, POOR
  packingQuality       String             @default("EXPORT") // EXPORT, DOMESTIC, DEFECTIVE
  numberOfHands        String
  fingerLengthDiameter String
  boxWeightKg          Decimal            @db.Decimal(5, 2)
  damageOnHand         String             @default("NONE") // NONE, LOW, HIGH
  latexSpots           Boolean            @default(false)
  redRust              Boolean            @default(false)
  flowerRemoved        Boolean            @default(true)
  overallQuality       String             @default("A_GRADE_EXPORT")
  box4H                Int                @default(0)
  box5H                Int                @default(0)
  box6H                Int                @default(0)
  box7H                Int                @default(0)
  box8H                Int                @default(0)
  totalBox             Int
  damageBox            Int                @default(0)
  boxBrand             String
  createdAt            DateTime           @default(now())

  @@map("kd_cold_storage_quality_reports")
}

// ─── Audit Log (Immutable Operational History) ──────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  userRole   UserRole
  action     String   // e.g., "INTAKE_CREATED", "SUPERVISOR_ASSIGNED", "RATE_LOCKED", "USER_CREATED"
  entityType String   // e.g., "PROCUREMENT_TASK", "FARMER", "USER"
  entityId   String
  details    String?  @db.Text // JSON metadata of changes
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@map("audit_logs")
}

// ─── Real-Time Notifications Feed ──────────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO") // INFO, ASSIGNMENT, FIELD_SUBMISSION, APPROVAL
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@map("notifications")
}
